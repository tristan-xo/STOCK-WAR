PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=STOCK_WARS_ADMIN
ADMIN_PASSWORD=123456789
EVENT_NAME=Stock Wars
STARTING_CAPITAL=200000
NEWS_SECONDS=120
TRADE_SECONDS=180
AUTO_NEWS=true
AUTO_NEWS_MIN_PCT=2
AUTO_NEWS_MAX_PCT=9
COST_BASIS_METHOD=FIFO
SLIPPAGE_BPS=5
MAX_IMPACT_BPS=50
# Local default. Render uses /var/data/stockwars.db through render.yaml.
DB_PATH=./stockwars.db
